{%- comment -%}
  OELNOR 3.0 product card.
  Accepts:
  - product: {Object}
  - position: {Number} 1-based position in the rail
  - show_rank: {Boolean} print the position as a ranking number
  - badge: {String} optional label (e.g. "Top ventas")
  - block: {Object} optional, for theme editor attributes
{%- endcomment -%}
{%- liquid
  assign media = product.featured_media
  assign alt_media = product.media[1]
  assign alt_text = product.title | escape
  assign sizes = '(min-width: 1100px) 25vw, (min-width: 750px) 40vw, 74vw'
  assign stagger = position | minus: 1 | modulo: 4
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<li class="o3-pcard" data-o3-reveal style="--i: {{ stagger }}" {% if block %}{{ block.shopify_attributes }}{% endif %}>
  <a class="o3-pcard__link" href="{{ product.url }}">
    <div class="o3-pcard__media">
      {%- if media -%}
        {{
          media
          | image_url: width: 900
          | image_tag: loading: 'lazy', widths: '300, 450, 600, 750, 900', sizes: sizes, alt: alt_text
        }}
        {%- if alt_media and alt_media.media_type == 'image' -%}
          {{
            alt_media
            | image_url: width: 900
            | image_tag: loading: 'lazy', class: 'o3-pcard__alt', widths: '300, 450, 600, 750, 900', sizes: sizes, alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-2' | placeholder_svg_tag }}
      {%- endif -%}
      {%- if show_rank -%}
        <span class="o3-pcard__rank o3-mono">{% if position < 10 %}0{% endif %}{{ position }}</span>
      {%- endif -%}
      {%- if badge != blank -%}
        <span class="o3-pcard__badge o3-mono">{{ badge }}</span>
      {%- elsif on_sale -%}
        <span class="o3-pcard__badge o3-mono">Oferta</span>
      {%- endif -%}
    </div>
    <div class="o3-pcard__info">
      <h3 class="o3-pcard__title">{{ product.title }}</h3>
      <p class="o3-pcard__price o3-mono">
        {%- if on_sale -%}
          <s><span class="o3-sr">Antes</span>{{ product.compare_at_price | money }}</s>
        {%- endif -%}
        {%- if product.price_varies -%}Desde {% endif -%}
        {{- product.price | money -}}
      </p>
      {%- if product.type != blank -%}
        <p class="o3-pcard__type o3-mono">{{ product.type }}</p>
      {%- endif -%}
      <span class="o3-pcard__go" aria-hidden="true">↗</span>
    </div>
  </a>
</li>
