{%- comment -%} Purchase guarantee: promise cards and a short FAQ. {%- endcomment -%}
<section class="o-section o-promise">
  <div class="o-container o-promise__grid">
    <div class="o-promise__lead">
      {%- if section.settings.eyebrow != blank -%}
        <p class="o-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="o-display o-promise__title" data-o-split>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="o-promise__text" data-o-reveal="fade" style="--i: 2">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <ul class="o-promise__items" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'promise' -%}
          <li data-o-reveal="fade" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a class="o-promise__item" href="{{ block.settings.link }}">{%- else -%}<div class="o-promise__item">{%- endif -%}
              <span class="o-promise__icon" aria-hidden="true">{% render 'oelnor-icon', name: block.settings.icon %}</span>
              <strong>{{ block.settings.title | escape }}</strong>
              {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

  {%- assign has_faq = false -%}
  {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}{%- assign has_faq = true -%}{%- endif -%}{%- endfor -%}
  {%- if has_faq -%}
    <div class="o-container o-promise__faq">
      <div class="o-pdp-acc">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details class="o-pdp-acc__item" {{ block.shopify_attributes }}>
              <summary><span>{{ block.settings.question | escape }}</span><span class="o-pdp-acc__plus" aria-hidden="true"></span></summary>
              <div class="o-pdp-acc__body rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Oelnor · Compra tranquila",
  "tag": "div",
  "class": "section-oelnor-promise",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nuestra promesa" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Compra con tranquilidad." },
    { "type": "textarea", "id": "text", "label": "Texto" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Garantía",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "return", "label": "Devolución" },
            { "value": "lock", "label": "Pago seguro" },
            { "value": "chat", "label": "Atención" },
            { "value": "pin", "label": "Seguimiento" },
            { "value": "heart", "label": "Corazón" },
            { "value": "star", "label": "Estrella" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Envío gratis" },
        { "type": "text", "id": "text", "label": "Texto" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    },
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Cuándo llega mi pedido?" },
        { "type": "richtext", "id": "answer", "label": "Respuesta" }
      ]
    }
  ],
  "presets": [{ "name": "Oelnor · Compra tranquila" }]
}
{% endschema %}
