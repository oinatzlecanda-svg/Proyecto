{%- comment -%}
  OELNOR 3.0 — Reviews. Loox summary from the product's metafields, the Loox
  widget (filled by the Loox app embed) and an honest empty state.
  Never shows reviews that do not exist.
{%- endcomment -%}
{%- liquid
  assign r_avg = product.metafields.loox.avg_rating.value
  assign r_num = product.metafields.loox.num_reviews.value
  if r_num == blank and product.metafields.reviews.rating_count.value != blank
    assign r_num = product.metafields.reviews.rating_count.value
    assign r_avg = product.metafields.reviews.rating.value.rating
  endif
  assign r_num = r_num | default: 0
  assign r_pct = r_avg | default: 0 | times: 20
-%}
<section class="o3 o3-psec o3-psec--dark" id="opiniones" aria-labelledby="O3ReviewsTitle-{{ section.id }}">
  <div class="o3-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <p class="o3-mono o3-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="o3-h2" id="O3ReviewsTitle-{{ section.id }}" style="margin-top: 12px;">{{ section.settings.heading }}</h2>
    {%- if r_num > 0 -%}
      <div class="o3-reviews__sum">
        <span class="o3-reviews__score">{{ r_avg | round: 1 | replace: '.', ',' }}</span>
        <span class="o3-stars" style="--r: {{ r_pct }}%" aria-hidden="true"></span>
        <span class="o3-mono">{{ r_num }} {% if r_num == 1 %}opinión{% else %}opiniones{% endif %} verificadas</span>
        <span class="o3-sr">Valoración media {{ r_avg | round: 1 }} de 5</span>
      </div>
    {%- else -%}
      <div class="o3-reviews__empty">
        <h3>{{ section.settings.empty_title }}</h3>
        <p>{{ section.settings.empty_text }}</p>
      </div>
    {%- endif -%}
    <div class="o3-reviews__widget">
      {%- if section.settings.loox_widget -%}
        <div id="looxReviews" data-product-id="{{ product.id }}">{{ product.metafields.loox.reviews }}</div>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "O3 · Opiniones",
  "tag": "div",
  "class": "o3-section",
  "settings": [
    { "type": "paragraph", "content": "Opiniones reales de Loox. Activa Loox en Configuración del tema → Incrustaciones de aplicaciones." },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Opiniones" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Lo que dice quien ya lo lleva" },
    { "type": "checkbox", "id": "loox_widget", "label": "Widget de Loox", "default": true },
    { "type": "text", "id": "empty_title", "label": "Sin opiniones: título", "default": "Todavía no hay opiniones de esta pieza" },
    { "type": "textarea", "id": "empty_text", "label": "Sin opiniones: texto", "default": "Cuando recibas tu pedido podrás contarnos qué te parece. Tu opinión ayuda a otras personas a elegir." }
  ],
  "blocks": [{ "type": "@app" }],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "O3 · Opiniones" }]
}
{% endschema %}
