{{ 'oelnor-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign rail_collection = section.settings.collection
  if rail_collection == blank
    assign rail_collection = collections['all']
  endif
  assign rail_products = rail_collection.products
  if section.settings.product_list != blank
    assign rail_products = section.settings.product_list
  endif
-%}

<section class="o-section o-rail" data-o-rail{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="o-rail__sticky">
    <div class="o-rail__head o-container">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="o-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="o-display o-rail__title" data-o-split>{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.view_all != blank -%}
        <a class="o-btn o-btn--ghost" data-o-magnetic href="{{ section.settings.view_all_link | default: rail_collection.url | default: routes.all_products_collection_url }}">
          {{ section.settings.view_all | escape }} <span class="o-btn__arrow" aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>

    <div class="o-rail__viewport">
      <ul class="o-rail__track" data-o-rail-track role="list">
        {%- for product in rail_products limit: section.settings.products_to_show -%}
          {%- if product.tags contains 'excluir-catalogo-moda' -%}{% continue %}{%- endif -%}
          {%- assign alt_text = product.featured_media.alt | default: product.title -%}
          <li class="o-rail__item" data-o-reveal="fade" style="--i: {{ forloop.index0 | at_most: 5 }}">
            <a class="o-card" href="{{ product.url }}" data-o-cursor="{{ section.settings.cursor_label | escape }}">
              <div class="o-card__media" data-o-tilt="6">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 28vw, 70vw',
                      widths: '360, 540, 720, 900',
                      class: 'o-card__img',
                      alt: alt_text
                  }}
                  {%- if product.media[1] -%}
                    {{
                      product.media[1]
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(min-width: 990px) 28vw, 70vw',
                        widths: '360, 540, 720, 900',
                        class: 'o-card__img o-card__img--alt',
                        alt: ''
                    }}
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'o-card__img' }}
                {%- endif -%}
                <span class="o-tilt-glare" aria-hidden="true"></span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="o-card__badge">Oferta</span>
                {%- elsif product.tags contains 'best-seller' -%}
                  <span class="o-card__badge">Best Seller</span>
                {%- endif -%}
              </div>
              <div class="o-card__info">
                <span class="o-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <h3 class="o-card__title">{{ product.title | escape }}</h3>
                <span class="o-card__price">
                  {%- if product.price_varies -%}Desde {% endif -%}
                  {{ product.price | money }}
                </span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="o-rail__progress o-container" aria-hidden="true">
      <span class="o-rail__bar"><span data-o-rail-progress></span></span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Oelnor · Carril productos",
  "tag": "div",
  "class": "section-oelnor-rail",
  "settings": [
    {
      "type": "paragraph",
      "content": "En ordenador la sección se fija y los productos se desplazan en horizontal al hacer scroll. En móvil se deslizan con el dedo."
    },
    { "type": "collection", "id": "collection", "label": "Colección" },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "O elige productos concretos",
      "limit": 16
    },
    { "type": "url", "id": "view_all_link", "label": "Enlace del botón (opcional)" },
    { "type": "text", "id": "anchor", "label": "Ancla (para enlazar con #)" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 10,
      "label": "Número de productos"
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Acaba de llegar" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Lo nuevo de la temporada" },
    { "type": "text", "id": "view_all", "label": "Texto del botón (vacío = sin botón)", "default": "Ver todo" },
    { "type": "text", "id": "cursor_label", "label": "Texto del cursor", "default": "Ver" }
  ],
  "presets": [{ "name": "Oelnor · Carril productos" }]
}
{% endschema %}
