{%- comment -%}
  OELNOR — Newsletter signup (Shopify customer form, tagged "newsletter").
  When a welcome code is set, it is shown right after subscribing, so the
  promise in the text is kept on the spot.
{%- endcomment -%}
{%- assign code = section.settings.code | strip | upcase -%}
<section class="o3 o3-signup" aria-labelledby="O3SignupTitle-{{ section.id }}">
  <div class="o3-wrap">
    <h2 class="o3-signup__title" id="O3SignupTitle-{{ section.id }}">
      {{- section.settings.title_1 -}}
      {%- if section.settings.title_2 != blank %} <span>{{ section.settings.title_2 }}</span>{%- endif -%}
    </h2>
    <div class="o3-signup__body">
      {%- if section.settings.text != blank -%}
        <p class="o3-signup__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- assign form_id = 'O3Signup-' | append: section.id -%}
      {%- form 'customer', id: form_id, class: 'o3-signup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter{% if code != blank %},oelnor-popup,{{ code | handleize }}{% endif %}">
        <input type="hidden" name="contact[accepts_marketing]" value="true">
        <label class="o3-sr" for="O3SignupEmail-{{ section.id }}">Correo electrónico</label>
        <input
          class="o3-input"
          id="O3SignupEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          autocomplete="email"
          autocapitalize="none"
          autocorrect="off"
          enterkeyhint="send"
          placeholder="tu@correo.com"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="O3SignupMsg-{{ section.id }}"{% endif %}
        >
        <button class="o3-btn o3-btn--solid" type="submit">{{ section.settings.button }}</button>
        {%- if form.errors -%}
          <p class="o3-signup__msg o3-signup__msg--error o3-mono" id="O3SignupMsg-{{ section.id }}" role="alert">
            {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
          </p>
        {%- elsif form.posted_successfully? -%}
          <p class="o3-signup__msg o3-mono" role="status">
            {{- section.settings.success -}}
            {%- if code != blank %} Tu código de bienvenida: <strong>{{ code }}</strong>{% endif -%}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "O3 · Newsletter",
  "tag": "div",
  "class": "o3-section",
  "settings": [
    { "type": "text", "id": "title_1", "label": "Título", "default": "Novedades," },
    { "type": "text", "id": "title_2", "label": "Título (cursiva)", "default": "antes que nadie" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Únete y te contamos las novedades antes que nadie. Sin spam." },
    { "type": "text", "id": "button", "label": "Botón", "default": "Unirme" },
    { "type": "text", "id": "success", "label": "Mensaje al suscribirse", "default": "Gracias, ya estás dentro." },
    { "type": "text", "id": "code", "label": "Código de bienvenida que se muestra al suscribirse (opcional)", "info": "Déjalo vacío si no ofreces descuento." }
  ],
  "presets": [{ "name": "O3 · Newsletter" }]
}
{% endschema %}
