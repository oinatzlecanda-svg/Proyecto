{% comment %}
  "Visto en Oelnor" — grid ready for TikTok/Instagram/UGC content.
  Each block can hold an image (post screenshot, product-in-use photo) and,
  optionally, a link back to the original TikTok/Instagram post.
  Ships with placeholder tiles until real content/videos are added.
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  {{ 'section-social-ugc.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="page-width">
      <div class="social-ugc__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="social-ugc__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      {%- if section.settings.link != blank and section.settings.link_label != blank -%}
        <a href="{{ section.settings.link }}" class="social-ugc__cta link">
          {{ section.settings.link_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="social-ugc__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="social-ugc__item" {{ block.shopify_attributes }}>
            {%- capture ugc_content -%}
              <div class="social-ugc__media">
                {%- if block.settings.image -%}
                  {{
                    block.settings.image
                    | image_url: width: 700
                    | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 20vw, (min-width: 750px) 33vw, 50vw', widths: '200,400,600,700'
                  }}
                {%- else -%}
                  {{ 'hero-apparel-3' | placeholder_svg_tag: 'social-ugc__placeholder' }}
                {%- endif -%}
                <span class="social-ugc__platform social-ugc__platform--{{ block.settings.platform }}">
                  {%- case block.settings.platform -%}
                    {%- when 'tiktok' -%}
                      TikTok
                    {%- when 'instagram' -%}
                      Instagram
                    {%- else -%}
                      UGC
                  {%- endcase -%}
                </span>
              </div>
            {%- endcapture -%}

            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="social-ugc__link" target="_blank" rel="noopener">
                {{ ugc_content }}
              </a>
            {%- else -%}
              {{ ugc_content }}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Visto en Oelnor",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Visto en Oelnor",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1",
      "label": "Tamaño del título"
    },
    {
      "type": "text",
      "id": "link_label",
      "default": "Síguenos",
      "label": "Texto del enlace"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace (perfil de Instagram/TikTok)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Publicación",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen o captura del post"
        },
        {
          "type": "select",
          "id": "platform",
          "options": [
            { "value": "tiktok", "label": "TikTok" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "other", "label": "Otro / UGC" }
          ],
          "default": "instagram",
          "label": "Plataforma"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace a la publicación original"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Visto en Oelnor",
      "blocks": [
        { "type": "post", "settings": { "platform": "instagram" } },
        { "type": "post", "settings": { "platform": "tiktok" } },
        { "type": "post", "settings": { "platform": "instagram" } },
        { "type": "post", "settings": { "platform": "tiktok" } }
      ]
    }
  ]
}
{% endschema %}
