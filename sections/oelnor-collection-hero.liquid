
{%- liquid
  # Chips for moving between collections:
  # 1. the collection's siblings when it lives in a submenu of the chosen menu
  #    (the largest submenu wins when it appears in several),
  # 2. otherwise the menu's top-level collection links,
  # and always a last chip to the full list of collections.
  assign nav_links = null
  assign nav_parent = null
  assign menu = section.settings.menu
  if menu != blank
    # When the collection sits in several submenus, keep the largest one.
    assign best_size = 0
    for link in linklists[menu].links
      assign is_member = false
      for child in link.links
        if child.url == collection.url
          assign is_member = true
        endif
      endfor
      if link.url == collection.url and link.links.size > 0
        assign is_member = true
      endif
      if is_member and link.links.size > best_size
        assign nav_links = link.links
        assign nav_parent = link
        assign best_size = link.links.size
      endif
    endfor
    if nav_links == null
      assign nav_links = linklists[menu].links
    endif
  endif

  assign fan_count = 0
-%}

<section class="o-section o-colhero">
  <div class="o-container o-colhero__grid">
    <div class="o-colhero__copy">
      <nav class="o-colhero__crumbs" aria-label="Ruta" data-o-reveal="fade">
        <a href="{{ routes.root_url }}">Inicio</a>
        <span aria-hidden="true">/</span>
        {%- if nav_parent and nav_parent.url != collection.url -%}
          <a href="{{ nav_parent.url }}">{{ nav_parent.title | escape }}</a>
          <span aria-hidden="true">/</span>
        {%- endif -%}
        <span aria-current="page">{{ collection.title | escape }}</span>
      </nav>

      <p class="o-eyebrow o-colhero__eyebrow" data-o-reveal="fade" style="--i: 1">
        {{ section.settings.eyebrow | escape }}
        <span class="o-colhero__count">{{ collection.products_count }} piezas</span>
      </p>

      <h1 class="o-display o-colhero__title" data-o-split style="--o-split-delay: 120ms">
        {{- collection.title | escape -}}
      </h1>

      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="o-colhero__text rte" data-o-reveal="fade" style="--i: 4">{{ collection.description }}</div>
      {%- endif -%}

      {%- if nav_links or section.settings.show_all_chip -%}
        <nav aria-label="{{ section.settings.chips_label | escape }}" data-o-reveal="fade" style="--i: 5">
          <ul class="o-colhero__chips" role="list">
            {%- for link in nav_links -%}
              {%- unless link.url contains '/collections' -%}{%- continue -%}{%- endunless -%}
              {%- if link.url == routes.collections_url and section.settings.show_all_chip -%}{%- continue -%}{%- endif -%}
              {%- assign is_current = false -%}
              {%- if link.url == collection.url or link.current -%}{%- assign is_current = true -%}{%- endif -%}
              <li>
                <a class="o-chip{% if is_current %} is-current{% endif %}" href="{{ link.url }}"{% if is_current %} aria-current="page"{% endif %}>
                  {{- link.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
            {%- if section.settings.show_all_chip -%}
              <li>
                <a class="o-chip o-chip--all" href="{{ routes.collections_url }}">
                  {{- section.settings.all_label | escape }} <span aria-hidden="true">→</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    {%- comment -%} Fan of the first product photos, tilts with the pointer. {%- endcomment -%}
    <div class="o-colhero__stage" data-o-tilt="7" aria-hidden="true">
      <div class="o-colhero__fan">
        {%- if section.settings.show_collection_image and collection.featured_image -%}
          {%- assign fan_count = 1 -%}
          <div class="o-colhero__card" style="--k: 0">
            {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 22vw, 45vw', widths: '360, 540, 720, 900', alt: '' }}
          </div>
        {%- endif -%}
        {%- for product in collection.products limit: 3 -%}
          {%- if fan_count >= 3 -%}{%- break -%}{%- endif -%}
          {%- if product.featured_media -%}
            <div class="o-colhero__card" style="--k: {{ fan_count }}">
              {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 22vw, 45vw', widths: '360, 540, 720, 900', alt: '' }}
            </div>
            {%- assign fan_count = fan_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <span class="o-tilt-glare"></span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Oelnor · Colección",
  "tag": "div",
  "class": "section-oelnor-colhero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "OELNOR / Colección" },
    { "type": "checkbox", "id": "show_description", "label": "Mostrar descripción de la colección", "default": true },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Usar la imagen de la colección como primera foto",
      "default": false
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú para las colecciones hermanas",
      "info": "Si la colección está dentro de un submenú, se muestran sus hermanas como accesos rápidos.",
      "default": "main-menu"
    },
    { "type": "text", "id": "chips_label", "label": "Etiqueta accesible de los accesos", "default": "Otras colecciones" },
    { "type": "checkbox", "id": "show_all_chip", "label": "Añadir acceso a todas las colecciones", "default": true },
    { "type": "text", "id": "all_label", "label": "Texto de ese acceso", "default": "Todas las colecciones" }
  ],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
