
{%- liquid
  assign img_a = section.settings.image_1
  if img_a == blank and section.settings.product_1 != blank
    assign img_a = section.settings.product_1.featured_media
  endif
  assign img_b = section.settings.image_2
  if img_b == blank and section.settings.product_2 != blank
    assign img_b = section.settings.product_2.featured_media
  endif
  assign img_c = section.settings.image_3
  if img_c == blank and section.settings.product_3 != blank
    assign img_c = section.settings.product_3.featured_media
  endif
  assign heading = section.settings.heading | default: page.title
-%}

<section class="o-section o-abhero" aria-label="{{ heading | escape }}">
  <div class="o-container o-abhero__grid">
    <div class="o-abhero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="o-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="o-display o-abhero__title">
        <span data-o-split style="--o-split-delay: 150ms">{{ heading | escape }}</span>
        {%- if section.settings.heading_accent != blank -%}
          <em data-o-split style="--o-split-delay: 320ms">{{ section.settings.heading_accent | escape }}</em>
        {%- endif -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="o-abhero__lead" data-o-reveal="fade" style="--i: 6">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.signature != blank -%}
        <p class="o-abhero__sign" data-o-reveal="fade" style="--i: 8">{{ section.settings.signature | escape }}</p>
      {%- endif -%}
    </div>

    <div class="o-abhero__collage" aria-hidden="true">
      {%- assign imgs = 'a,b,c' | split: ',' -%}
      {%- for slot in imgs -%}
        {%- liquid
          case slot
            when 'a'
              assign im = img_a
              assign speed = '0.05'
            when 'b'
              assign im = img_b
              assign speed = '-0.05'
            else
              assign im = img_c
              assign speed = '0.07'
          endcase
        -%}
        <figure class="o-abhero__img o-abhero__img--{{ slot }}" data-o-reveal="clip" style="--i: {{ forloop.index0 | times: 2 }}">
          <div class="o-abhero__parallax" data-o-parallax="{{ speed }}">
            {%- if im != blank -%}
              {{ im | image_url: width: 1100 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 28vw, 60vw', widths: '450, 700, 900, 1100', alt: '' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'o-placeholder' }}
            {%- endif -%}
          </div>
        </figure>
      {%- endfor -%}
    </div>
  </div>
  <span class="o-hero3d__scroll" aria-hidden="true"><span></span></span>
</section>

{% schema %}
{
  "name": "Oelnor · Hero Sobre",
  "tag": "div",
  "class": "section-oelnor-about-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Sobre Oelnor" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Una idea" },
    { "type": "text", "id": "heading_accent", "label": "Titular, segunda línea (destacada)", "default": "sencilla." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Oelnor nace de una idea sencilla: vestir bien también puede ser una forma de expresarte."
    },
    { "type": "text", "id": "signature", "label": "Firma (opcional)", "default": "— El equipo Oelnor" },
    { "type": "image_picker", "id": "image_1", "label": "Foto grande" },
    { "type": "product", "id": "product_1", "label": "O foto de producto (grande)" },
    { "type": "image_picker", "id": "image_2", "label": "Foto superior" },
    { "type": "product", "id": "product_2", "label": "O foto de producto (superior)" },
    { "type": "image_picker", "id": "image_3", "label": "Foto pequeña" },
    { "type": "product", "id": "product_3", "label": "O foto de producto (pequeña)" }
  ],
  "presets": [{ "name": "Oelnor · Hero Sobre" }]
}
{% endschema %}
