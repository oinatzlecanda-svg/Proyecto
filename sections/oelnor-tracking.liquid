{{ 'oelnor-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tracker_url = section.settings.tracker_url | default: '/apps/parcelpanel'
-%}

<section class="o-section o-track">
  <div class="o-container o-track__hero">
    <div class="o-track__copy">
      <nav class="o-colhero__crumbs" aria-label="Ruta" data-o-reveal="fade">
        <a href="{{ routes.root_url }}">Inicio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ page.title | default: 'Localizar pedido' | escape }}</span>
      </nav>
      <p class="o-eyebrow" data-o-reveal="fade" style="--i: 1">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="o-display o-track__title" data-o-split>{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="o-track__lead" data-o-reveal="fade" style="--i: 3">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <div class="o-track__actions" data-o-reveal="fade" style="--i: 4">
        <a class="o-btn" data-o-magnetic href="{{ tracker_url }}">
          {{ section.settings.button_label | escape }} <span class="o-btn__arrow" aria-hidden="true">→</span>
        </a>
        {%- if customer -%}
          <a class="o-btn o-btn--ghost" href="{{ routes.account_url }}">Ver mis pedidos</a>
        {%- endif -%}
      </div>
      {%- if section.settings.helper != blank -%}
        <p class="o-track__helper" data-o-reveal="fade" style="--i: 5">{{ section.settings.helper | escape }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} The journey of a parcel, drawn as a live route. Decorative. {%- endcomment -%}
    <div class="o-track__card-wrap" data-o-reveal="fade" style="--i: 2">
    <div class="o-track__card" data-o-tilt="5" aria-hidden="true">
      <p class="o-eyebrow">Estado del pedido</p>
      <p class="o-track__card-status">En camino</p>
      <div class="o-track__route">
        <span class="o-track__route-line"><span class="o-track__route-fill"></span></span>
        <span class="o-track__parcel">
          <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 10 16 4l11 6v12l-11 6-11-6z"/><path d="M5 10l11 6 11-6M16 16v12"/></svg>
        </span>
      </div>
      <ul class="o-track__card-steps" role="list">
        {%- for block in section.blocks -%}
          <li><span></span>{{ block.settings.title | escape }}</li>
        {%- endfor -%}
      </ul>
      <span class="o-tilt-glare"></span>
    </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="o-container o-track__steps-wrap">
      <div class="o-track__steps-head">
        <p class="o-eyebrow" data-o-reveal="fade">{{ section.settings.steps_eyebrow | escape }}</p>
        <h2 class="o-display o-track__steps-title" data-o-split>{{ section.settings.steps_heading | escape }}</h2>
      </div>
      <ol class="o-track__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="o-track__step" {{ block.shopify_attributes }} data-o-reveal="fade" style="--i: {{ forloop.index0 }}">
            <span class="o-track__step-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="o-track__step-title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.time != blank -%}
              <p class="o-track__step-time">{{ block.settings.time | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="o-track__step-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.footnote != blank -%}
        <p class="o-track__footnote" data-o-reveal="fade">{{ section.settings.footnote | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="o-dark o-track__help">
    <div class="o-container o-track__help-grid">
      <h2 class="o-display o-track__help-title" data-o-split>{{ section.settings.help_heading | escape }}</h2>
      <div class="o-track__help-copy">
        <p data-o-reveal="fade">{{ section.settings.help_text | escape }}</p>
        <div class="o-track__actions" data-o-reveal="fade" style="--i: 1">
          <a class="o-btn" data-o-magnetic href="{{ section.settings.help_link | default: '/pages/contact' }}">
            {{ section.settings.help_button | escape }} <span class="o-btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="o-btn o-btn--ghost" href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">Política de envíos</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Oelnor · Localizar envío",
  "tag": "div",
  "class": "section-oelnor-track",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "OELNOR / Seguimiento" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "¿Dónde está tu pedido?" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Introduce tus datos en nuestro localizador y revisa el estado del envío en cualquier momento."
    },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Localizar mi pedido" },
    {
      "type": "url",
      "id": "tracker_url",
      "label": "Enlace del localizador",
      "info": "Por defecto, la página de seguimiento de ParcelPanel (/apps/parcelpanel)."
    },
    {
      "type": "text",
      "id": "helper",
      "label": "Ayuda bajo el botón",
      "default": "Ten a mano tu número de pedido y el email con el que compraste."
    },
    { "type": "text", "id": "steps_eyebrow", "label": "Antetítulo de pasos", "default": "El viaje de tu pedido" },
    { "type": "text", "id": "steps_heading", "label": "Titular de pasos", "default": "Así llega a tu casa." },
    { "type": "text", "id": "footnote", "label": "Nota bajo los pasos" },
    { "type": "text", "id": "help_heading", "label": "Titular de ayuda", "default": "¿Algo no cuadra?" },
    {
      "type": "text",
      "id": "help_text",
      "label": "Texto de ayuda",
      "default": "Si no aparece información o necesitas ayuda con tu pedido, escríbenos y lo revisamos contigo."
    },
    { "type": "text", "id": "help_button", "label": "Botón de ayuda", "default": "Contactar" },
    { "type": "url", "id": "help_link", "label": "Enlace de ayuda" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Paso" },
        { "type": "text", "id": "time", "label": "Plazo (opcional)" },
        { "type": "text", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "enabled_on": { "templates": ["page"] },
  "presets": [{ "name": "Oelnor · Localizar envío" }]
}
{% endschema %}
