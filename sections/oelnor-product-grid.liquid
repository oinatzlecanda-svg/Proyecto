
{%- liquid
  assign grid_products = section.settings.product_list
  if grid_products == blank and section.settings.collection != blank
    assign grid_products = section.settings.collection.products
  endif
  assign shown = 0
  for product in grid_products limit: section.settings.limit
    assign shown = shown | plus: 1
  endfor
-%}

<section class="o-section o-pgrid" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="o-container">
    <header class="o-pgrid__head">
      <div class="o-pgrid__titles">
        {%- if section.settings.eyebrow != blank -%}
          <p class="o-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="o-display o-pgrid__title" data-o-split>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="o-pgrid__text" data-o-reveal="fade" style="--i: 2">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      <span class="o-colhero__count" data-o-reveal="fade" style="--i: 3">{{ shown }} piezas</span>
    </header>

    <ul class="o-pgrid__list{% if section.settings.layout == 'editorial' %} o-pgrid__list--editorial{% endif %}" role="list">
      {%- for product in grid_products limit: section.settings.limit -%}
        {%- assign alt_text = product.featured_media.alt | default: product.title -%}
        <li class="o-pgrid__item" data-o-reveal="fade" style="--i: {{ forloop.index0 | modulo: 4 }}">
          <a class="o-card" href="{{ product.url }}" data-o-cursor="{{ section.settings.cursor_label | escape }}">
            <div class="o-card__media" data-o-tilt="5">
              {%- if product.featured_media -%}
                {{
                  product.featured_media
                  | image_url: width: 1000
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 30vw, 50vw',
                    widths: '360, 540, 720, 1000',
                    class: 'o-card__img',
                    alt: alt_text
                }}
                {%- if product.media[1] -%}
                  {{
                    product.media[1]
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 990px) 30vw, 50vw',
                      widths: '360, 540, 720, 1000',
                      class: 'o-card__img o-card__img--alt',
                      alt: ''
                  }}
                {%- endif -%}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'o-card__img' }}
              {%- endif -%}
              <span class="o-tilt-glare" aria-hidden="true"></span>
              {%- unless product.available -%}
                <span class="o-card__badge">Agotado</span>
              {%- else -%}
                {%- if product.compare_at_price > product.price -%}
                  <span class="o-card__badge">Oferta</span>
                {%- endif -%}
              {%- endunless -%}
            </div>
            <div class="o-card__info">
              <span class="o-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="o-card__title">{{ product.title | escape }}</h3>
              <span class="o-card__price">
                {%- if product.compare_at_price > product.price -%}
                  <s class="o-card__was">{{ product.compare_at_price | money }}</s>
                {%- endif -%}
                {{ product.price | money }}
              </span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="o-pgrid__foot" data-o-reveal="fade">
        <a class="o-btn o-btn--ghost" data-o-magnetic href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }} <span class="o-btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Oelnor · Cuadrícula",
  "tag": "div",
  "class": "section-oelnor-pgrid",
  "settings": [
    { "type": "product_list", "id": "product_list", "label": "Productos", "limit": 24 },
    { "type": "collection", "id": "collection", "label": "O una colección" },
    { "type": "range", "id": "limit", "min": 2, "max": 24, "step": 1, "default": 12, "label": "Máximo de productos" },
    {
      "type": "select",
      "id": "layout",
      "label": "Composición",
      "options": [
        { "value": "grid", "label": "Cuadrícula regular" },
        { "value": "editorial", "label": "Editorial (alturas alternas)" }
      ],
      "default": "editorial"
    },
    { "type": "text", "id": "anchor", "label": "Ancla (para enlazar con #)", "info": "Ej.: seleccion" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Piezas que marcan el look." },
    { "type": "text", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "text", "id": "cursor_label", "label": "Texto del cursor", "default": "Ver" }
  ],
  "presets": [{ "name": "Oelnor · Cuadrícula" }]
}
{% endschema %}
