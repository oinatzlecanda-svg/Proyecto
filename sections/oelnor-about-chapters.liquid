
<section class="o-section o-chapters">
  <div class="o-container">
    {%- if section.settings.heading != blank -%}
      <div class="o-chapters__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="o-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="o-display o-chapters__heading" data-o-split>{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <ol class="o-chapters__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign im = block.settings.image
          if im == blank and block.settings.product != blank
            assign im = block.settings.product.featured_media
          endif
        -%}
        <li class="o-chapter{% if im == blank %} o-chapter--text{% endif %}" {{ block.shopify_attributes }}>
          {%- if im != blank -%}
            <figure class="o-chapter__media" data-o-reveal="clip">
              <div class="o-chapter__parallax" data-o-parallax="{% cycle '0.08', '-0.08' %}">
                {{ im | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 44vw, 92vw', widths: '540, 720, 960, 1200, 1400', alt: block.settings.title }}
              </div>
            </figure>
          {%- endif -%}
          <div class="o-chapter__copy">
            <span class="o-chapter__num" data-o-reveal="fade" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- if block.settings.kicker != blank -%}
              <p class="o-eyebrow" data-o-reveal="fade" style="--i: 1">{{ block.settings.kicker | escape }}</p>
            {%- endif -%}
            <h3 class="o-display o-chapter__title" data-o-split>{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="o-chapter__text" data-o-reveal="fade" style="--i: 3">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="o-btn o-btn--ghost" data-o-magnetic data-o-reveal="fade" style="--i: 4" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
                {{ block.settings.button_label | escape }} <span class="o-btn__arrow" aria-hidden="true">→</span>
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Oelnor · Capítulos",
  "tag": "div",
  "class": "section-oelnor-chapters",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nuestra historia" },
    { "type": "text", "id": "heading", "label": "Titular (opcional)" }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Capítulo",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "La idea" },
        { "type": "text", "id": "title", "label": "Título", "default": "Piezas con algo especial." },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "product", "id": "product", "label": "O foto de un producto" },
        { "type": "text", "id": "button_label", "label": "Botón (opcional)" },
        { "type": "url", "id": "button_link", "label": "Enlace del botón" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Oelnor · Capítulos",
      "blocks": [{ "type": "chapter" }, { "type": "chapter" }]
    }
  ]
}
{% endschema %}
