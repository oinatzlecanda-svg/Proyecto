{{ 'oelnor-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_collection = section.settings.collection
  if hero_collection == blank
    assign hero_collection = collections['all']
  endif
  assign limit = section.settings.products_to_show
  assign hero_products = hero_collection.products
  if section.settings.product_list != blank
    assign hero_products = section.settings.product_list
  endif
-%}

<section
  class="o-section o-hero3d"
  data-o-hero3d
  data-three-src="{{ 'three.module.min.js' | asset_url }}"
  data-layout="{{ section.settings.layout }}"
  {% if section.settings.show_intro and template.name == 'index' %}
    data-o-intro="{{ shop.name | upcase | escape }}"
  {% endif %}
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="o-hero3d__stage" data-o-hero-canvas>
    {%- comment -%} Static fallback while three.js loads (or without WebGL). {%- endcomment -%}
    <div class="o-hero3d__fallback" aria-hidden="true">
      {%- for product in hero_products limit: 5 -%}
        {%- if product.featured_media -%}
          <div class="o-hero3d__fallback-item" style="--i: {{ forloop.index0 }}">
            {{
              product.featured_media
              | image_url: width: 700
              | image_tag: loading: 'eager', sizes: '30vw', alt: ''
            }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-o-hero-items>
    [
      {%- for product in hero_products limit: limit -%}
        {
          "src": {% if product.featured_media %}{{ product.featured_media | image_url: width: 900 | prepend: 'https:' | json }}{% else %}null{% endif %},
          "url": {{ product.url | json }},
          "title": {{ product.title | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  <div class="o-hero3d__veil" aria-hidden="true"></div>

  <div class="o-hero3d__content o-container">
    <div class="o-hero3d__top">
      {%- if section.settings.eyebrow != blank -%}
        <p class="o-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        <p class="o-eyebrow o-hero3d__tagline" data-o-reveal="fade" style="--i: 2">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
    </div>

    <h1 class="o-display o-hero3d__title">
      <span data-o-split style="--o-split-delay: 250ms">{{ section.settings.heading | escape }}</span>
      {%- if section.settings.heading_accent != blank -%}
        <em data-o-split style="--o-split-delay: 420ms">{{ section.settings.heading_accent | escape }}</em>
      {%- endif -%}
    </h1>

    <div class="o-hero3d__bottom">
      <div class="o-hero3d__intro">
        {%- if section.settings.text != blank -%}
          <p class="o-hero3d__text" data-o-reveal="fade" style="--i: 6">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        <div class="o-hero3d__actions" data-o-reveal="fade" style="--i: 8">
          {%- if section.settings.button_label_1 != blank -%}
            <a class="o-btn" data-o-magnetic href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}">
              {{ section.settings.button_label_1 | escape }} <span class="o-btn__arrow" aria-hidden="true">→</span>
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="o-btn o-btn--ghost" data-o-magnetic href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}">
              {{ section.settings.button_label_2 | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.note != blank -%}
        {%- liquid
          assign shown = hero_products.size
          if shown > limit
            assign shown = limit
          endif
        -%}
        <p class="o-hero3d__note" data-o-reveal="fade" style="--i: 10">
          <span class="o-hero3d__count">{{ shown | prepend: '0' | slice: -2, 2 }}</span>
          <span class="o-hero3d__note-text">
            {{- section.settings.note | escape -}}
            {%- if section.settings.hint != blank -%}<span class="o-hero3d__note-hint">{{ section.settings.hint | escape }}</span>{%- endif -%}
          </span>
        </p>
      {%- endif -%}
    </div>
  </div>

  <p class="o-hero3d__label" data-o-hero-label aria-hidden="true"></p>
  <span class="o-hero3d__scroll" aria-hidden="true"><span></span></span>
</section>

<script src="{{ 'oelnor-hero-3d.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Oelnor · Hero 3D",
  "tag": "div",
  "class": "section-oelnor-hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Anillo 3D interactivo con las fotos de la colección elegida. Se puede arrastrar y cada foto enlaza a su producto."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Movimiento 3D",
      "options": [
        { "value": "ring", "label": "Anillo que gira" },
        { "value": "fall", "label": "Fotos que caen como hojas" }
      ],
      "default": "ring"
    },
    { "type": "collection", "id": "collection", "label": "Colección a mostrar" },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "O elige productos concretos",
      "limit": 16,
      "info": "Si eliges productos, se usan en lugar de la colección."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 6,
      "max": 16,
      "step": 1,
      "default": 12,
      "label": "Productos en el anillo"
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Colección otoño · 2026" },
    { "type": "text", "id": "tagline", "label": "Frase de la esquina (opcional)", "default": "Mujer · Hombre · Accesorios" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Estilo" },
    { "type": "text", "id": "heading_accent", "label": "Titular, segunda línea (destacada)", "default": "con intención." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Prendas y accesorios con carácter, elegidos uno a uno para que vistas a tu manera." },
    { "type": "text", "id": "button_label_1", "label": "Botón 1", "default": "Descubrir novedades" },
    { "type": "url", "id": "button_link_1", "label": "Enlace botón 1" },
    { "type": "text", "id": "button_label_2", "label": "Botón 2", "default": "Ver todo" },
    { "type": "url", "id": "button_link_2", "label": "Enlace botón 2" },
    { "type": "text", "id": "note", "label": "Contador: texto (vacío lo oculta)", "default": "piezas en la selección" },
    { "type": "text", "id": "hint", "label": "Pista de interacción", "default": "Arrastra para girar" },
    {
      "type": "checkbox",
      "id": "show_intro",
      "label": "Intro con el nombre de la tienda (una vez por visita)",
      "default": true
    }
  ],
  "presets": [{ "name": "Oelnor · Hero 3D" }]
}
{% endschema %}
