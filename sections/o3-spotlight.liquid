{%- comment -%}
  OELNOR 3.0 — Product spotlight on cobalt. Real add-to-cart (AJAX into the
  cart drawer when it exists, plain form post otherwise).
{%- endcomment -%}
{%- liquid
  assign product = section.settings.product
  assign current = product.selected_or_first_available_variant
  assign alt_text = product.title | escape
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<section class="o3 o3-spot" data-o3-spot aria-labelledby="O3SpotTitle-{{ section.id }}">
  <div class="o3-wrap o3-spot__grid">
    <div class="o3-spot__visual" data-o3-spot-visual>
      <div class="o3-spot__card" data-o3-spot-card>
        <a class="o3-card3d__face" href="{{ product.url | default: routes.all_products_collection_url }}" tabindex="-1" aria-hidden="true" draggable="false">
          {%- if product.featured_media -%}
            {{
              product.featured_media
              | image_url: width: 1100
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1100',
                sizes: '(min-width: 900px) 520px, 92vw',
                alt: alt_text,
                draggable: 'false'
            }}
          {%- else -%}
            {{ 'product-apparel-3' | placeholder_svg_tag }}
          {%- endif -%}
        </a>
        {%- if section.settings.sticker_ring != blank -%}
          <div class="o3-sticker" aria-hidden="true">
            <svg viewBox="0 0 100 100">
              <defs><path id="O3Sticker-{{ section.id }}" d="M50,8 a42,42 0 1,1 0,84 a42,42 0 1,1 0,-84"></path></defs>
              <text textLength="258" lengthAdjust="spacing">
                <textPath href="#O3Sticker-{{ section.id }}">{{ section.settings.sticker_ring }} • {{ section.settings.sticker_ring }} •</textPath>
              </text>
            </svg>
            <b>{{ section.settings.sticker_center }}</b>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="o3-spot__body" data-o3-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="o3-spot__eyebrow o3-mono o3-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="o3-spot__title" id="O3SpotTitle-{{ section.id }}">
        {{- section.settings.title | default: product.title | default: 'Producto destacado' -}}
      </h2>
      <div class="o3-spot__text">
        {%- if section.settings.text != blank -%}
          {{ section.settings.text }}
        {%- else -%}
          <p>{{ product.description | strip_html | truncatewords: 32 }}</p>
        {%- endif -%}
      </div>

      {%- if product != blank -%}
        <p class="o3-spot__price">
          {%- if on_sale -%}<s><span class="o3-sr">Antes</span>{{ product.compare_at_price | money }}</s>{%- endif -%}
          <span>{{ current.price | money }}</span>
        </p>

        {%- form 'product', product, class: 'o3-spot__form', data-o3-form: '', novalidate: 'novalidate' -%}
          {%- if product.has_only_default_variant -%}
            <input type="hidden" name="id" value="{{ current.id }}">
          {%- else -%}
            <div class="o3-field">
              <label class="o3-mono" for="O3Variant-{{ section.id }}">{{ product.options | join: ' / ' }}</label>
              <select class="o3-select" id="O3Variant-{{ section.id }}" name="id">
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == current %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{- variant.title }} — {{ variant.price | money | strip_html -}}
                    {%- unless variant.available %} · Agotado{% endunless -%}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
          <div class="o3-spot__actions">
            <button
              type="submit"
              name="add"
              class="o3-btn o3-btn--ink o3-spot__add"
              data-added="Añadido a la cesta ✓"
              {% unless product.available %}disabled{% endunless %}
            >
              {%- if product.available -%}Añadir a la cesta{%- else -%}Agotado{%- endif -%}
            </button>
            <a class="o3-btn o3-btn--ghost" href="{{ product.url }}">Ver detalles</a>
          </div>
          <p class="o3-spot__status o3-mono" data-o3-status role="status" aria-live="polite"></p>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "O3 · Producto foco",
  "tag": "div",
  "class": "o3-section",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "El más vendido" },
    { "type": "text", "id": "title", "label": "Título (vacío = nombre del producto)" },
    { "type": "richtext", "id": "text", "label": "Texto (vacío = descripción del producto)" },
    { "type": "text", "id": "sticker_ring", "label": "Pegatina: texto circular", "default": "Best seller" },
    { "type": "text", "id": "sticker_center", "label": "Pegatina: centro", "default": "Nº1" }
  ],
  "presets": [{ "name": "O3 · Producto foco" }]
}
{% endschema %}
