{{ 'oelnor-sections.css' | asset_url | stylesheet_tag }}

<section class="o-section o-catindex{% if section.settings.layout == 'cards' %} o-catindex--cards{% endif %}"{% unless section.settings.layout == 'cards' %} data-o-catindex{% endunless %}>
  <div class="o-container">
    <div class="o-catindex__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="o-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="o-display o-catindex__title" data-o-split>{{ section.settings.heading | escape }}</h2>
    </div>

    {%- if section.settings.layout == 'cards' -%}
    <ul class="o-catcards" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign img = block.settings.image
          if img == blank and block.settings.product != blank
            assign img = block.settings.product.featured_media
          endif
          if img == blank and col != blank
            assign img = col.featured_image
          endif
          assign title = block.settings.title | default: col.title
          assign link = block.settings.link | default: col.url | default: routes.all_products_collection_url
        -%}
        <li class="o-catcards__item" {{ block.shopify_attributes }} data-o-reveal="fade" style="--i: {{ forloop.index0 | modulo: 4 }}">
          <a class="o-catcards__tile" href="{{ link }}" data-o-cursor="Ver">
            <div class="o-catcards__media">
              {%- if img != blank -%}
                {{ img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 24vw, 50vw', widths: '360, 540, 720, 900', alt: title }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'o-placeholder' }}
              {%- endif -%}
            </div>
            <span class="o-catcards__name">{{ title | escape }} <span aria-hidden="true">↗</span></span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- else -%}
    <ul class="o-catindex__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign img = block.settings.image
          if img == blank and block.settings.product != blank
            assign img = block.settings.product.featured_media
          endif
          if img == blank and col != blank
            assign img = col.featured_image
          endif
          assign title = block.settings.title
          if title == blank and col != blank
            assign title = col.title
          endif
          assign link = block.settings.link
          if link == blank and col != blank
            assign link = col.url
          endif
        -%}
        <li class="o-catindex__row" {{ block.shopify_attributes }} data-o-reveal="fade" style="--i: {{ forloop.index0 }}">
          <span class="o-catindex__rule" data-o-reveal="line" style="--i: {{ forloop.index0 }}" aria-hidden="true"></span>
          <a class="o-catindex__link" href="{{ link | default: routes.all_products_collection_url }}">
            <span class="o-catindex__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="o-catindex__name">
              {%- if block.settings.kicker != blank -%}<span class="o-catindex__kicker">{{ block.settings.kicker | escape }}</span>{%- endif -%}
              {{- title | escape -}}
            </span>
            {%- if col != blank -%}
              <span class="o-catindex__count">{{ col.products_count }} piezas</span>
            {%- endif -%}
            <span class="o-catindex__arrow" aria-hidden="true">↗</span>
          </a>
          {%- if img != blank -%}
            <template data-o-catindex-img>
              {{ img | image_url: width: 640 | image_tag: loading: 'lazy', alt: '', sizes: '320px' }}
            </template>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- endif -%}
  </div>
  {%- unless section.settings.layout == 'cards' -%}
    <div class="o-catindex__float" aria-hidden="true"><div class="o-catindex__float-inner"></div></div>
  {%- endunless -%}
</section>

<script>
  (() => {
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('[data-o-catindex]:not([data-ready])').forEach((root) => {
      root.dataset.ready = '';
      if (!fine) return;
      const float = root.querySelector('.o-catindex__float');
      const inner = float.querySelector('.o-catindex__float-inner');
      let tx = 0, ty = 0, x = 0, y = 0, vx = 0, raf = 0, last = 0, active = false;
      // Frame-rate independent follow: same feel at 60Hz and 120Hz.
      const follow = (dt) => 1 - Math.pow(1 - 0.14, dt / 16.667);
      const loop = (now) => {
        const dt = Math.min(64, now - (last || now - 16.667));
        last = now;
        const k = follow(dt);
        const nx = x + (tx - x) * k;
        vx = ((nx - x) * 16.667) / dt;
        x = nx;
        y += (ty - y) * k;
        const rot = reduce ? 0 : Math.max(-12, Math.min(12, vx * 0.6));
        float.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0) rotate(${rot.toFixed(2)}deg)`;
        const moving = Math.abs(tx - x) > 0.5 || Math.abs(ty - y) > 0.5;
        raf = moving ? requestAnimationFrame(loop) : 0;
        if (!raf) last = 0;
      };
      root.addEventListener('pointermove', (e) => {
        tx = e.clientX;
        ty = e.clientY;
        if (!raf) raf = requestAnimationFrame(loop);
      });
      root.querySelectorAll('.o-catindex__row').forEach((row) => {
        const tpl = row.querySelector('[data-o-catindex-img]');
        row.addEventListener('pointerenter', (e) => {
          if (!tpl) return;
          if (!active) {
            x = tx = e.clientX;
            y = ty = e.clientY;
          }
          active = true;
          inner.replaceChildren(tpl.content.cloneNode(true));
          float.classList.add('is-active');
          if (!raf) raf = requestAnimationFrame(loop);
        });
        row.addEventListener('pointerleave', () => {
          active = false;
          float.classList.remove('is-active');
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Oelnor · Categorías",
  "tag": "div",
  "class": "section-oelnor-catindex",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Diseño",
      "options": [
        { "value": "list", "label": "Lista grande con foto flotante" },
        { "value": "cards", "label": "Tarjetas con foto" }
      ],
      "default": "list"
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Explora" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Encuentra lo tuyo" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Nombre (opcional)" },
        { "type": "text", "id": "kicker", "label": "Antetítulo (opcional)", "info": "Ej.: The layers edit" },
        { "type": "image_picker", "id": "image", "label": "Imagen al pasar el ratón (opcional)" },
        { "type": "product", "id": "product", "label": "O usa la foto de un producto" },
        { "type": "url", "id": "link", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Oelnor · Categorías",
      "blocks": [
        { "type": "category", "settings": { "title": "Mujer" } },
        { "type": "category", "settings": { "title": "Hombre" } },
        { "type": "category", "settings": { "title": "Bolsos" } },
        { "type": "category", "settings": { "title": "Calzado" } }
      ]
    }
  ]
}
{% endschema %}
