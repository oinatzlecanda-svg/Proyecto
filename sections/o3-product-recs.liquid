{%- comment -%}
  OELNOR 3.0 — Product recommendations (complementary or related), loaded
  after first paint through Shopify's recommendations endpoint. Hides itself
  when Shopify has nothing to suggest.
{%- endcomment -%}
{%- liquid
  assign intent = section.settings.intent
  assign recs_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: section.settings.limit | append: '&intent=' | append: intent
-%}
<section
  class="o3 o3-rail o3-recs{% if section.settings.dark %} o3-rail--dark{% endif %}"
  data-o3-recs
  data-url="{{ recs_url }}"
  {% unless recommendations.performed? and recommendations.products_count > 0 %}data-empty{% endunless %}
  aria-labelledby="O3RecsTitle-{{ section.id }}"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="o3-wrap" data-o3-rail>
      <header class="o3-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="o3-head__eyebrow o3-mono o3-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="o3-head__title" id="O3RecsTitle-{{ section.id }}" style="font-size: clamp(44px, 12vw, 112px);">{{ section.settings.title }}</h2>
      </header>
      <ul class="o3-rail__track" data-o3-track role="list">
        {%- for p in recommendations.products -%}
          {%- render 'o3-product-card', product: p, position: forloop.index, show_rank: false -%}
        {%- endfor -%}
      </ul>
      <div class="o3-rail__progress" aria-hidden="true"><span data-o3-progress></span></div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "O3 · Recomendados",
  "tag": "div",
  "class": "o3-section",
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "Tipo",
      "options": [
        { "value": "complementary", "label": "Complementarios (Search & Discovery)" },
        { "value": "related", "label": "Relacionados" }
      ],
      "default": "related"
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Te puede gustar" },
    { "type": "text", "id": "title", "label": "Título", "default": "Más del drop" },
    { "type": "range", "id": "limit", "label": "Productos", "min": 2, "max": 10, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "dark", "label": "Fondo oscuro", "default": false }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "O3 · Recomendados" }]
}
{% endschema %}
