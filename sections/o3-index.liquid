{%- comment -%}
  OELNOR 3.0 — Collection index.
  Giant type list. Desktop: orange wipe + a preview that follows the cursor.
  Mobile: inline thumbnail on every row.
{%- endcomment -%}
<section class="o3 o3-index" data-o3-index aria-labelledby="O3IndexTitle-{{ section.id }}">
  <div class="o3-wrap">
    <header class="o3-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="o3-head__eyebrow o3-mono o3-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="o3-head__title" id="O3IndexTitle-{{ section.id }}">{{ section.settings.title }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="o3-btn o3-btn--light o3-head__link" href="{{ section.settings.link | default: routes.collections_url }}">
          {{- section.settings.link_label }} <span class="o3-btn__arrow" aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </header>

    <ul class="o3-index__list" data-o3-list role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign name = block.settings.title | default: c.title | default: 'Colección'
          assign img = block.settings.image | default: c.featured_image
          if block.settings.product != blank
            assign img = block.settings.product.featured_media
          endif
        -%}
        <li class="o3-index__row" data-o3-reveal style="--i: {{ forloop.index0 | modulo: 6 }}" {{ block.shopify_attributes }}>
          <a class="o3-index__link" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.collections_url }}{% endif %}" data-o3-row>
            <span class="o3-index__name">{{ name }}</span>
            {%- if c != blank -%}
              <span class="o3-index__count o3-mono">
                {{- c.products_count -}}
                <span class="o3-sr"> productos</span>
              </span>
            {%- endif -%}
            <span class="o3-index__thumb" aria-hidden="true">
              {%- if img != blank -%}
                {{ img | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 64, height: 64 }}
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="o3-index__float" data-o3-float aria-hidden="true">
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.collection
        assign img = block.settings.image | default: c.featured_image
        if block.settings.product != blank
          assign img = block.settings.product.featured_media
        endif
      -%}
      {%- if img != blank -%}
        {{ img | image_url: width: 480 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        <img alt="" src="data:," hidden>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "O3 · Colecciones",
  "tag": "div",
  "class": "o3-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Colecciones" },
    { "type": "text", "id": "title", "label": "Título", "default": "Elige tu código" },
    { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "Todo Oelnor" },
    { "type": "url", "id": "link", "label": "Enlace" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Nombre a mostrar (opcional)" },
        { "type": "product", "id": "product", "label": "Imagen desde producto (opcional)" },
        { "type": "image_picker", "id": "image", "label": "Imagen propia (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "O3 · Colecciones",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
