{{ 'oelnor-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign img = section.settings.image
  if img == blank and section.settings.product != blank
    assign img = section.settings.product.featured_media
  endif
-%}

<section class="o-section o-feature">
  <a class="o-feature__card o-container" href="{{ section.settings.link | default: routes.all_products_collection_url }}" data-o-cursor="{{ section.settings.cursor_label | escape }}">
    <div class="o-feature__media" data-o-reveal="clip">
      <div class="o-feature__parallax" data-o-parallax="0.1">
        {%- if img != blank -%}
          {{ img | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 60vw, 100vw', widths: '540, 720, 960, 1200, 1600, 1800', alt: section.settings.heading }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'o-placeholder' }}
        {%- endif -%}
      </div>
      {%- if section.settings.season != blank -%}
        <span class="o-feature__season" aria-hidden="true">{{ section.settings.season | escape }}</span>
      {%- endif -%}
    </div>

    <div class="o-feature__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="o-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="o-display o-feature__title" data-o-split>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="o-feature__text" data-o-reveal="fade" style="--i: 3">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <span class="o-btn o-btn--ghost" data-o-reveal="fade" style="--i: 4">
          {{ section.settings.button_label | escape }} <span class="o-btn__arrow" aria-hidden="true">→</span>
        </span>
      {%- endif -%}
    </div>
  </a>
</section>

{% schema %}
{
  "name": "Oelnor · Destacado",
  "tag": "div",
  "class": "section-oelnor-feature",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "product", "id": "product", "label": "O usa la foto de un producto" },
    { "type": "url", "id": "link", "label": "Enlace (toda la tarjeta)" },
    { "type": "text", "id": "season", "label": "Palabra grande sobre la foto", "default": "Otoño" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Selección de otoño" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "El frío no es excusa." },
    {
      "type": "text",
      "id": "text",
      "label": "Texto",
      "default": "Botas, capas, punto y denim para cuando baja la temperatura."
    },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver la selección" },
    { "type": "text", "id": "cursor_label", "label": "Texto del cursor", "default": "Ver" }
  ],
  "presets": [{ "name": "Oelnor · Destacado" }]
}
{% endschema %}
