{{ 'oelnor-sections.css' | asset_url | stylesheet_tag }}

<section
  class="o-section o-dark o-offer"
  data-o-offer
  {% if section.settings.ends_at != blank %}data-ends-at="{{ section.settings.ends_at | escape }}"{% endif %}
  aria-labelledby="OfferTitle-{{ section.id }}"
>
  <div class="o-container o-offer__grid">
    <div class="o-offer__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="o-eyebrow o-offer__kicker" data-o-reveal="fade"><span aria-hidden="true"></span>{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h2 class="o-display o-offer__title" id="OfferTitle-{{ section.id }}">
        <span data-o-split>{{ section.settings.heading | escape }}</span>
        {%- if section.settings.heading_accent != blank -%}
          <span class="o-offer__accent" data-o-split style="--o-split-delay: 180ms">{{ section.settings.heading_accent | escape }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.description != blank -%}
        <p class="o-offer__text" data-o-reveal="fade" style="--i: 3">{{ section.settings.description | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="o-btn" data-o-magnetic data-o-reveal="fade" style="--i: 4" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }} <span class="o-btn__arrow" aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>

    <div class="o-offer__badge" role="img" data-o-tilt="10" aria-label="{{ section.settings.number }} % {{ section.settings.line_1 | escape }} {{ section.settings.line_2 | escape }}">
      <span class="o-offer__ring" aria-hidden="true"></span>
      <span class="o-offer__top" aria-hidden="true">{{ section.settings.top_label | escape }}</span>
      <span class="o-offer__number" aria-hidden="true">
        <span class="o-offer__minus">−</span><span data-o-count="{{ section.settings.number }}">{{ section.settings.number }}</span><span class="o-offer__pct">%</span>
      </span>
      <span class="o-offer__lines" aria-hidden="true">
        <span>{{ section.settings.line_1 | escape }}</span>
        <span>{{ section.settings.line_2 | escape }}</span>
      </span>
      <span class="o-tilt-glare" aria-hidden="true"></span>
    </div>
  </div>
</section>

<script>
  (() => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('[data-o-offer]:not([data-ready])').forEach((root) => {
      root.dataset.ready = '';
      // Optional end date: the band disappears by itself once the offer is over.
      const ends = Date.parse(root.dataset.endsAt || '');
      if (Number.isFinite(ends) && Date.now() > ends) {
        root.hidden = true;
        return;
      }
      const el = root.querySelector('[data-o-count]');
      if (!el || reduce) return;
      const target = parseInt(el.dataset.oCount, 10) || 0;
      el.textContent = '0';
      new IntersectionObserver((entries, io) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        const start = performance.now();
        const step = (now) => {
          const t = Math.min(1, (now - start) / 1100);
          const eased = 1 - Math.pow(1 - t, 4);
          el.textContent = Math.round(eased * target);
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }, { threshold: 0.4 }).observe(root);
    });
  })();
</script>

{% schema %}
{
  "name": "Oelnor · Oferta",
  "tag": "div",
  "class": "section-oelnor-offer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Banda de promoción. Asegúrate de que el descuento existe en Admin → Descuentos antes de mostrarla."
    },
    { "type": "text", "id": "kicker", "label": "Etiqueta pequeña", "default": "OELNOR / Combina a tu manera" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Dos piezas o más." },
    { "type": "text", "id": "heading_accent", "label": "Titular destacado", "default": "25 % menos." },
    {
      "type": "text",
      "id": "description",
      "label": "Texto",
      "default": "El descuento se aplica automáticamente al total de tu pedido. Sin códigos ni complicaciones."
    },
    { "type": "range", "id": "number", "min": 5, "max": 90, "step": 5, "unit": "%", "default": 25, "label": "Porcentaje" },
    { "type": "text", "id": "top_label", "label": "Texto sobre el número", "default": "Tu próxima combinación" },
    { "type": "text", "id": "line_1", "label": "Línea 1 bajo el número", "default": "En todo tu pedido" },
    { "type": "text", "id": "line_2", "label": "Línea 2 bajo el número", "default": "Con 2 o más artículos" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Descúbrelo" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    {
      "type": "text",
      "id": "ends_at",
      "label": "Fecha de fin (opcional)",
      "info": "Formato 2026-12-31T23:59:00+01:00. Pasada la fecha, la banda se oculta sola."
    }
  ],
  "presets": [{ "name": "Oelnor · Oferta" }]
}
{% endschema %}
