{% comment %}
  Small interactive section: a row of pill buttons that send the visitor
  to a collection, a filtered collection URL, or the search page.
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  {{ 'section-product-discovery.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="product-discovery__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      <div class="product-discovery__options">
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="product-discovery__pill"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label | escape }}
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "¿Qué buscas hoy?",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "¿Qué buscas hoy?",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h2",
      "label": "Tamaño del título"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Opción",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Algo útil",
          "label": "Texto del botón"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (colección, filtro o búsqueda)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "¿Qué buscas hoy?",
      "blocks": [
        { "type": "option", "settings": { "label": "Algo útil" } },
        { "type": "option", "settings": { "label": "Algo diferente" } },
        { "type": "option", "settings": { "label": "Un accesorio" } },
        { "type": "option", "settings": { "label": "Algo para llevar" } },
        { "type": "option", "settings": { "label": "Solo estoy mirando" } }
      ]
    }
  ]
}
{% endschema %}
