{%- comment -%}
  OELNOR 3.0 — Purchase promise (shipping, returns, payment, help) and the
  questions people ask right before buying.
{%- endcomment -%}
{%- liquid
  assign promises = section.blocks | where: 'type', 'promise'
  assign faqs = section.blocks | where: 'type', 'faq'
-%}
<section class="o3 o3-psec o3-psec--light" aria-labelledby="O3PromiseTitle-{{ section.id }}">
  <div class="o3-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <p class="o3-mono o3-eyebrow o3-mono-mute">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="o3-h2" id="O3PromiseTitle-{{ section.id }}" style="margin-top: 12px;">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="o3-psec__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if promises.size > 0 -%}
      <ul class="o3-promise" role="list">
        {%- for block in promises -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">
                <strong>{{ block.settings.title }}</strong>
                <span>{{ block.settings.text }}</span>
              </a>
            {%- else -%}
              <strong>{{ block.settings.title }}</strong>
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if faqs.size > 0 -%}
      <div class="o3-faq">
        <div class="o3-faq__list">
          {%- for block in faqs -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }} <i aria-hidden="true"></i></summary>
              <div class="o3-faq__a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "O3 · Promesa",
  "tag": "div",
  "class": "o3-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nuestra promesa" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Compra sin miedo" },
    { "type": "textarea", "id": "text", "label": "Texto" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Garantía",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Envío gratis" },
        { "type": "text", "id": "text", "label": "Texto" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    },
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "Pregunta" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Respuesta</p>" }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "O3 · Promesa" }]
}
{% endschema %}
