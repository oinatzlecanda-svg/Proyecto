{%- comment -%}
  OELNOR 3.0 — Recommendations that make sense: same gender as the product
  (Moda Mujer / Moda Hombre), best sellers first. "Combínalo con" shows
  other categories (one per category); "Más de…" shows the same category
  first. Picking logic: snippets/o3-picks.liquid. Rendered server-side.
{%- endcomment -%}
{%- capture picks -%}
  {%- render 'o3-picks',
    product: product,
    source: section.settings.source,
    women: section.settings.women,
    men: section.settings.men,
    exclude: section.settings.exclude,
    limit: section.settings.limit
  -%}
{%- endcapture -%}
{%- liquid
  assign parts = picks | strip | split: '|'
  if section.settings.mode == 'complete'
    assign list = parts[0] | split: ','
  else
    assign list = parts[1] | split: ','
  endif

  assign gender_title = ''
  for c in product.collections
    if c.handle == section.settings.women or c.handle == section.settings.men
      assign gender_title = c.title | remove: 'Moda ' | strip
      break
    endif
  endfor
  assign title = section.settings.title | replace: '[genero]', gender_title
  if gender_title == ''
    assign title = section.settings.title | replace: ' de [genero]', '' | replace: '[genero]', 'Oelnor'
  endif
-%}

{%- if list.size > 0 -%}
  <section
    class="o3 o3-rail{% if section.settings.dark %} o3-rail--dark{% endif %}"
    data-o3-rail
    aria-labelledby="O3PicksTitle-{{ section.id }}"
  >
    <div class="o3-wrap">
      <header class="o3-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="o3-head__eyebrow o3-mono o3-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="o3-head__title" id="O3PicksTitle-{{ section.id }}">{{ title }}</h2>
      </header>
      <ul class="o3-rail__track" data-o3-track role="list">
        {%- for handle in list -%}
          {%- assign p = all_products[handle] -%}
          {%- if p != blank -%}
            {%- render 'o3-product-card', product: p, position: forloop.index, show_rank: false -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="o3-rail__progress" aria-hidden="true"><span data-o3-progress></span></div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "O3 · Sugerencias",
  "tag": "div",
  "class": "o3-section",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Tipo",
      "options": [
        { "value": "complete", "label": "Combínalo con (otras categorías)" },
        { "value": "similar", "label": "Parecidos (misma categoría primero)" }
      ],
      "default": "complete"
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Completa el look" },
    { "type": "text", "id": "title", "label": "Título", "default": "Combínalo con", "info": "[genero] se cambia por Mujer u Hombre." },
    { "type": "range", "id": "limit", "label": "Productos", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "dark", "label": "Fondo oscuro", "default": false },
    { "type": "header", "content": "Reglas" },
    { "type": "text", "id": "source", "label": "Colección de la que salen (su orden manda)", "default": "todos-los-productos-oelnor" },
    { "type": "text", "id": "women", "label": "Colección de mujer", "default": "mujer" },
    { "type": "text", "id": "men", "label": "Colección de hombre", "default": "hombre" },
    {
      "type": "textarea",
      "id": "exclude",
      "label": "Colecciones que no son categoría",
      "default": "mujer,hombre,todos-los-productos-oelnor,destacados-oelnor,la-seleccion-oelnor,accesorios,prendas-de-arriba-hombre",
      "info": "Separadas por comas. La categoría de un producto es su primera colección que no esté aquí."
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "O3 · Sugerencias" }]
}
{% endschema %}
