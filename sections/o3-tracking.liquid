{%- comment -%}
  OELNOR — Shipping and tracking page. Sends people to the ParcelPanel
  tracker (/apps/parcelpanel), sums up the shipping facts, explains the real
  delivery timeline (blocks) and offers help.
{%- endcomment -%}
{%- assign tracker_url = section.settings.tracker_url | default: '/apps/parcelpanel' -%}

<section class="o3 o3-track" aria-labelledby="O3TrackTitle-{{ section.id }}">
  <div class="o3-phero o3-top">
    <div class="o3-wrap o3-track__grid">
      <div>
        <nav class="o3-crumbs o3-mono" aria-label="Ruta">
          <a href="{{ routes.root_url }}">Inicio</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ page.title | default: 'Localiza tu envío' | escape }}</span>
        </nav>
        {%- if section.settings.eyebrow != blank -%}
          <p class="o3-phero__eyebrow o3-mono o3-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="o3-phero__title" id="O3TrackTitle-{{ section.id }}">
          <span class="o3-line"><span>{{ section.settings.heading_1 }}</span></span>
          {%- if section.settings.heading_2 != blank -%}
            <span class="o3-line"><span class="o3-mark">{{ section.settings.heading_2 }}</span></span>
          {%- endif -%}
        </h1>
        {%- if section.settings.text != blank -%}
          <p class="o3-phero__text">{{ section.settings.text }}</p>
        {%- endif -%}
        <div class="o3-track__actions">
          <a class="o3-btn o3-btn--solid" href="{{ tracker_url }}">
            {{- section.settings.button_label -}}
          </a>
          {%- if customer -%}
            <a class="o3-btn o3-btn--ghost" href="{{ routes.account_url }}">Ver mis pedidos</a>
          {%- endif -%}
        </div>
        {%- if section.settings.helper != blank -%}
          <p class="o3-track__helper o3-mono">{{ section.settings.helper }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.fact_1_title != blank -%}
        <ul class="o3-facts" role="list">
          {%- for i in (1..4) -%}
            {%- liquid
              assign f_t = 'fact_' | append: i | append: '_title'
              assign f_x = 'fact_' | append: i | append: '_text'
            -%}
            {%- if section.settings[f_t] != blank -%}
              <li>
                <strong>{{ section.settings[f_t] }}</strong>
                <span>{{ section.settings[f_x] }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="o3-light" style="padding-block: var(--o3-space);">
      <div class="o3-wrap">
        <p class="o3-mono o3-eyebrow o3-mono-mute">{{ section.settings.steps_eyebrow }}</p>
        <h2 class="o3-h2" style="margin-top: 12px;">{{ section.settings.steps_heading }}</h2>
        <ol class="o3-steps" role="list">
          {%- for block in section.blocks -%}
            <li data-o3-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <span class="o3-steps__n" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
              <h3>{{ block.settings.title }}</h3>
              {%- if block.settings.time != blank -%}
                <p class="o3-steps__time o3-mono">{{ block.settings.time }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
        {%- if section.settings.footnote != blank -%}
          <p class="o3-foot-note">{{ section.settings.footnote }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="o3-help">
    <div class="o3-wrap o3-help__grid">
      <h2 class="o3-h2">{{ section.settings.help_heading }}</h2>
      <div>
        <p>{{ section.settings.help_text }}</p>
        <div class="o3-track__actions">
          <a class="o3-btn o3-btn--ink" href="{{ section.settings.help_link | default: '/pages/contact' }}">
            {{- section.settings.help_button -}}
          </a>
          <a class="o3-btn o3-btn--outline" href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}">Política de envíos</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "O3 · Envíos y seguimiento",
  "tag": "div",
  "class": "o3-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Seguimiento" },
    { "type": "text", "id": "heading_1", "label": "Titular línea 1", "default": "¿Dónde está" },
    { "type": "text", "id": "heading_2", "label": "Titular línea 2 (resaltada)", "default": "tu pedido?" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Localizar mi pedido" },
    { "type": "url", "id": "tracker_url", "label": "Enlace del localizador", "info": "Por defecto, ParcelPanel (/apps/parcelpanel)." },
    { "type": "text", "id": "helper", "label": "Ayuda bajo el botón" },
    { "type": "header", "content": "Datos de envío" },
    { "type": "text", "id": "fact_1_title", "label": "Dato 1", "default": "Envío gratis" },
    { "type": "text", "id": "fact_1_text", "label": "Detalle 1", "default": "En todos los pedidos, con seguimiento." },
    { "type": "text", "id": "fact_2_title", "label": "Dato 2", "default": "1–3 días laborables" },
    { "type": "text", "id": "fact_2_text", "label": "Detalle 2", "default": "Lo que tardamos en preparar tu pedido." },
    { "type": "text", "id": "fact_3_title", "label": "Dato 3", "default": "7–14 días laborables" },
    { "type": "text", "id": "fact_3_text", "label": "Detalle 3", "default": "Plazo aproximado de entrega desde el envío. Puede alargarse en campañas o por el transportista." },
    { "type": "text", "id": "fact_4_title", "label": "Dato 4", "default": "Seguimiento por email" },
    { "type": "text", "id": "fact_4_text", "label": "Detalle 4", "default": "Te enviamos el número para seguir el pedido en cada momento." },
    { "type": "text", "id": "steps_eyebrow", "label": "Antetítulo de pasos", "default": "El viaje de tu pedido" },
    { "type": "text", "id": "steps_heading", "label": "Titular de pasos", "default": "Así llega a tu casa" },
    { "type": "textarea", "id": "footnote", "label": "Nota bajo los pasos" },
    { "type": "text", "id": "help_heading", "label": "Titular de ayuda", "default": "¿Algo no cuadra?" },
    { "type": "textarea", "id": "help_text", "label": "Texto de ayuda" },
    { "type": "text", "id": "help_button", "label": "Botón de ayuda", "default": "Contactar" },
    { "type": "url", "id": "help_link", "label": "Enlace de ayuda" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Paso" },
        { "type": "text", "id": "time", "label": "Plazo (opcional)" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "enabled_on": { "templates": ["page"] },
  "presets": [{ "name": "O3 · Localizar envío" }]
}
{% endschema %}
