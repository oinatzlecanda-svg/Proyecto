{% comment %}
  Renders a visual grid of "use case" cards (e.g. "Para salir", "Para llevar").
  Each card links to a collection, a filtered collection URL or any page —
  the merchant decides where via the block's link field.
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  {{ 'section-discover-by-use.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="discover-by-use__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      <div class="discover-by-use__grid discover-by-use__grid--{{ section.settings.columns_desktop }}-col">
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="discover-by-use__card"
            {{ block.shopify_attributes }}
          >
            <div class="discover-by-use__media">
              {%- if block.settings.image -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', widths: '200,400,600,800'
                }}
              {%- else -%}
                {{ 'hero-apparel-2' | placeholder_svg_tag: 'discover-by-use__placeholder' }}
              {%- endif -%}
            </div>
            <span class="discover-by-use__label">{{ block.settings.title | escape }}</span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Descubre por uso",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Encuentra lo tuyo",
      "label": "Título"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1",
      "label": "Tamaño del título"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4",
      "label": "Columnas en escritorio"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Tarjeta",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Para salir",
          "label": "Texto"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (colección, filtro o página)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Descubre por uso",
      "blocks": [
        { "type": "card", "settings": { "title": "Para salir" } },
        { "type": "card", "settings": { "title": "Para llevar" } },
        { "type": "card", "settings": { "title": "Para organizar" } },
        { "type": "card", "settings": { "title": "Para completar el look" } }
      ]
    }
  ]
}
{% endschema %}
