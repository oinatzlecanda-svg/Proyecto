{{ 'oelnor-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign story = section.settings.text
  if story == blank
    assign story = product.description | strip_html | truncatewords: 42, '…'
  endif
-%}

<section class="o-section o-story">
  <div class="o-story__ticker" aria-hidden="true">
    <div class="o-story__ticker-track">
      {%- for i in (1..4) -%}
        <span>{{ product.title | escape }}</span><span class="o-story__ticker-dot">✦</span>
      {%- endfor -%}
    </div>
  </div>

  <div class="o-container o-story__grid">
    <div class="o-story__lead">
      <p class="o-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
      {%- if story != blank -%}
        <p class="o-story__text" data-o-scrub>{{ story | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="o-story__benefits" role="list">
        {%- for block in section.blocks -%}
          <li class="o-story__benefit" {{ block.shopify_attributes }} data-o-reveal="fade" style="--i: {{ forloop.index0 }}">
            <span class="o-story__benefit-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div>
              <h3 class="o-story__benefit-title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="o-story__benefit-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Oelnor · Historia",
  "tag": "div",
  "class": "section-oelnor-story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Por qué te va a gustar" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "info": "Si lo dejas vacío se usa el inicio de la descripción del producto."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Ventaja",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Ventaja" },
        { "type": "text", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Oelnor · Historia" }]
}
{% endschema %}
