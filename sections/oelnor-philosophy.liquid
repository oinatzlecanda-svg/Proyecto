
{%- liquid
  assign philo_img = section.settings.image
  if philo_img == blank and section.settings.product != blank
    assign philo_img = section.settings.product.featured_media
  endif
-%}

<section class="o-section o-philo">
  <div class="o-container o-philo__grid">
    <div class="o-philo__lead">
      {%- if section.settings.eyebrow != blank -%}
        <p class="o-eyebrow" data-o-reveal="fade">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.quote != blank -%}
        <h2 class="o-display o-philo__quote" data-o-scrub>{{ section.settings.quote | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="o-philo__text" data-o-reveal="fade" style="--i: 2">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="o-btn o-btn--ghost" data-o-magnetic data-o-reveal="fade" style="--i: 3" href="{{ section.settings.button_link | default: routes.root_url }}">
          {{ section.settings.button_label | escape }} <span class="o-btn__arrow" aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>

    <figure class="o-philo__media" data-o-reveal="clip" style="--i: 1">
      <div class="o-philo__parallax" data-o-parallax="0.08">
        {%- if philo_img != blank -%}
          {{ philo_img | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 38vw, 90vw', widths: '540, 720, 960, 1200, 1400', alt: section.settings.quote }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'o-placeholder' }}
        {%- endif -%}
      </div>
      {%- if section.settings.caption != blank -%}
        <figcaption class="o-philo__caption">{{ section.settings.caption | escape }}</figcaption>
      {%- endif -%}
    </figure>
  </div>

  {%- if section.blocks.size > 0 -%}
    <ol class="o-container o-philo__pillars" role="list">
      {%- for block in section.blocks -%}
        <li class="o-philo__pillar" {{ block.shopify_attributes }} data-o-reveal="fade" style="--i: {{ forloop.index0 }}">
          <span class="o-philo__rule" data-o-reveal="line" style="--i: {{ forloop.index0 }}" aria-hidden="true"></span>
          <span class="o-philo__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="o-philo__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="o-philo__body">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Oelnor · Filosofía",
  "tag": "div",
  "class": "section-oelnor-philosophy",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nuestra filosofía" },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Frase principal (se ilumina al hacer scroll)",
      "default": "Vestir bien también puede ser una forma de expresarte."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "No buscamos seguir todas las tendencias, sino encontrar piezas con personalidad que encajen de forma natural en tu día a día."
    },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Nuestra historia" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "product", "id": "product", "label": "O foto de un producto" },
    { "type": "text", "id": "caption", "label": "Pie de foto (opcional)" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Principio",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Personalidad" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Oelnor · Filosofía",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Personalidad", "text": "Piezas con un detalle diferente, elegidas para hacer tuyo cualquier look." } },
        { "type": "pillar", "settings": { "title": "Sin reglas", "text": "Probar, combinar y vestir a tu manera, sin seguir cada tendencia." } },
        { "type": "pillar", "settings": { "title": "Para cada día", "text": "Diseño, comodidad y calidad que te acompañan del lunes al domingo." } }
      ]
    }
  ]
}
{% endschema %}
