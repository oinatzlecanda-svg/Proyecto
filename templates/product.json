{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "tagline": {
          "type": "text",
          "settings": {
            "text": "Escribe aquí una frase corta que explique de un vistazo para qué sirve este producto.",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price"
        },
        "rating": {
          "type": "rating"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "benefits": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "check_mark",
            "heading_1": "Beneficio 1 — explica qué gana el cliente, no solo la característica",
            "icon_2": "check_mark",
            "heading_2": "Beneficio 2 — explica qué gana el cliente, no solo la característica",
            "icon_3": "check_mark",
            "heading_3": "Beneficio 3 — explica qué gana el cliente, no solo la característica"
          }
        },
        "description": {
          "type": "description"
        },
        "disclosures": {
          "type": "disclosures"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Compartir"
          }
        }
      },
      "block_order": [
        "title",
        "tagline",
        "price",
        "rating",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "benefits",
        "description",
        "disclosures",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 28,
        "padding_bottom": 12
      }
    },
    "product-details": {
      "type": "collapsible-content",
      "blocks": {
        "row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Características",
            "icon": "none",
            "row_content": "<p>Añade aquí las características reales del producto.</p>"
          }
        },
        "row-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Medidas",
            "icon": "none",
            "row_content": "<p>Añade aquí las medidas reales del producto.</p>"
          }
        }
      },
      "block_order": ["row-1", "row-2"],
      "settings": {
        "caption": "",
        "heading": "",
        "heading_size": "h1",
        "heading_alignment": "left",
        "layout": "none",
        "container_color_scheme": "scheme-1",
        "color_scheme": "scheme-1",
        "open_first_collapsible_row": false,
        "image_ratio": "adapt",
        "desktop_layout": "image_first",
        "padding_top": 0,
        "padding_bottom": 20
      }
    },
    "problem-product-result": {
      "type": "problem-product-result",
      "blocks": {},
      "block_order": [],
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "how-it-works": {
      "type": "how-it-works",
      "blocks": {},
      "block_order": [],
      "settings": {
        "heading": "Cómo funciona",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "También te puede gustar",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "main",
    "product-details",
    "problem-product-result",
    "how-it-works",
    "related-products"
  ]
}
