{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "rating": {
          "type": "oelnor_rating",
          "settings": {
            "empty_label": "Sé la primera persona en opinar"
          }
        },
        "price": {
          "type": "price"
        },
        "tip": {
          "type": "oelnor_tip",
          "settings": {
            "label": "Cómo llevarlo",
            "fallback": ""
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 5,
            "show_inventory_quantity": true
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "delivery": {
          "type": "oelnor_delivery",
          "settings": {
            "badge": "Envío gratis",
            "min_days": 8,
            "max_days": 17,
            "note": "Con número de seguimiento"
          }
        },
        "trust": {
          "type": "oelnor_trust",
          "settings": {
            "icon_1": "truck",
            "title_1": "Envío gratis",
            "text_1": "Con seguimiento",
            "icon_2": "return",
            "title_2": "30 días",
            "text_2": "Para devolver",
            "icon_3": "lock",
            "title_3": "Pago seguro",
            "text_3": "Datos cifrados",
            "icon_4": "chat",
            "title_4": "Te ayudamos",
            "text_4": "Respuesta rápida",
            "show_payments": true
          }
        },
        "details": {
          "type": "oelnor_accordion",
          "settings": {
            "description_title": "Descripción",
            "open_description": true,
            "title_1": "Envíos",
            "content_1": "<p>Preparamos tu pedido en 1–3 días hábiles y el transporte tarda 7–14 días hábiles. Recibirás un número de seguimiento por email.</p><p><a href=\"/policies/shipping-policy\" title=\"Política de envíos\">Ver política de envíos</a></p>",
            "title_2": "Devoluciones",
            "content_2": "<p>Tienes 30 días desde que recibes tu pedido para devolverlo.</p><p><a href=\"/policies/refund-policy\" title=\"Política de devoluciones\">Ver política de devoluciones</a></p>",
            "title_3": "Pago seguro",
            "content_3": "<p>El pago se procesa de forma cifrada a través de Shopify con los métodos que ves arriba. Oelnor no guarda los datos de tu tarjeta.</p>"
          }
        },
        "disclosures": {
          "type": "disclosures"
        }
      },
      "block_order": [
        "title",
        "rating",
        "price",
        "tip",
        "variant_picker",
        "inventory",
        "buy_buttons",
        "delivery",
        "trust",
        "details",
        "disclosures"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 28,
        "padding_bottom": 12
      }
    },
    "product-details": {
      "type": "collapsible-content",
      "blocks": {
        "row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Características",
            "icon": "none",
            "row_content": "<p>Añade aquí las características reales del producto.</p>"
          }
        },
        "row-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Medidas",
            "icon": "none",
            "row_content": "<p>Añade aquí las medidas reales del producto.</p>"
          }
        }
      },
      "block_order": [
        "row-1",
        "row-2"
      ],
      "settings": {
        "caption": "",
        "heading": "",
        "heading_size": "h1",
        "heading_alignment": "left",
        "layout": "none",
        "container_color_scheme": "scheme-1",
        "color_scheme": "scheme-1",
        "open_first_collapsible_row": false,
        "image_ratio": "adapt",
        "desktop_layout": "image_first",
        "padding_top": 0,
        "padding_bottom": 20
      },
      "disabled": true
    },
    "problem-product-result": {
      "type": "problem-product-result",
      "blocks": {},
      "block_order": [],
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 48,
        "padding_bottom": 48
      },
      "disabled": true
    },
    "how-it-works": {
      "type": "how-it-works",
      "blocks": {},
      "block_order": [],
      "settings": {
        "heading": "Cómo funciona",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 48
      },
      "disabled": true
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "También te puede gustar",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "oelnor-vista-3d": {
      "type": "oelnor-product-3d",
      "settings": {
        "eyebrow": "Vista 360°",
        "heading": "Míralo desde todos los ángulos",
        "hint": "Arrastra o usa las flechas para girar"
      }
    },
    "oelnor-historia": {
      "type": "oelnor-product-story",
      "settings": {
        "eyebrow": "Por qué te va a gustar",
        "text": ""
      },
      "blocks": {},
      "block_order": [],
      "disabled": true
    },
    "oelnor-barra": {
      "type": "oelnor-product-sticky",
      "settings": {
        "label": "Añadir a la cesta"
      }
    },
    "oelnor-look": {
      "type": "oelnor-product-look",
      "settings": {
        "eyebrow": "Completa el look",
        "heading": "Combínalo con.",
        "limit": 4
      }
    },
    "oelnor-opiniones": {
      "type": "oelnor-product-reviews",
      "settings": {
        "eyebrow": "Opiniones",
        "heading": "Lo que dice quien ya lo lleva.",
        "count_prefix": "Basado en",
        "loox_widget": true,
        "empty_title": "Todavía no hay opiniones de esta pieza.",
        "empty_text": "Cuando recibas tu pedido podrás contarnos qué te parece. Tu opinión ayuda a otras personas a elegir."
      },
      "blocks": {},
      "block_order": []
    },
    "oelnor-promesa": {
      "type": "oelnor-product-promise",
      "settings": {
        "eyebrow": "Nuestra promesa",
        "heading": "Compra con tranquilidad.",
        "text": "Si algo no es como esperabas, lo solucionamos. Sin letra pequeña."
      },
      "blocks": {
        "p1": {
          "type": "promise",
          "settings": {
            "icon": "truck",
            "title": "Envío gratis",
            "text": "Con número de seguimiento en cada pedido.",
            "link": "shopify://pages/localizar-pedido"
          }
        },
        "p2": {
          "type": "promise",
          "settings": {
            "icon": "return",
            "title": "30 días para devolver",
            "text": "Desde que recibes tu pedido.",
            "link": "/policies/refund-policy"
          }
        },
        "p3": {
          "type": "promise",
          "settings": {
            "icon": "lock",
            "title": "Pago seguro",
            "text": "Pagos cifrados con los principales métodos.",
            "link": ""
          }
        },
        "p4": {
          "type": "promise",
          "settings": {
            "icon": "chat",
            "title": "Atención cercana",
            "text": "Escríbenos y te respondemos lo antes posible.",
            "link": "shopify://pages/contact"
          }
        },
        "f1": {
          "type": "faq",
          "settings": {
            "question": "¿Cuándo llega mi pedido?",
            "answer": "<p>Lo preparamos en 1–3 días hábiles y el transporte tarda 7–14 días hábiles. En la ficha de cada producto verás la fecha estimada.</p>"
          }
        },
        "f2": {
          "type": "faq",
          "settings": {
            "question": "¿Cómo sé dónde está mi pedido?",
            "answer": "<p>Te enviamos un número de seguimiento por email. También puedes consultarlo en <a href=\"/pages/localizar-pedido\" title=\"Localizar pedido\">Localizar pedido</a>.</p>"
          }
        },
        "f3": {
          "type": "faq",
          "settings": {
            "question": "¿Puedo devolverlo si no me convence?",
            "answer": "<p>Sí, tienes 30 días desde que lo recibes. Consulta los pasos en la <a href=\"/policies/refund-policy\" title=\"Política de devoluciones\">política de devoluciones</a>.</p>"
          }
        },
        "f4": {
          "type": "faq",
          "settings": {
            "question": "¿Qué talla elijo?",
            "answer": "<p>Si dudas entre dos tallas, <a href=\"/pages/contact\" title=\"Contacto\">escríbenos</a> antes de comprar y te ayudamos a elegir.</p>"
          }
        }
      },
      "block_order": [
        "p1",
        "p2",
        "p3",
        "p4",
        "f1",
        "f2",
        "f3",
        "f4"
      ]
    }
